{
  "_comment": "Authored KPI catalog (founder table 2026-07-31). Each KPI binds to model anchors (DocType.field). binding: bound = data recorded today | capture = needs floor discipline | schema = concept missing from data model. Values live in the OBSERVED plane (the ERP computes them) — Praxis shows the anatomy: formula → anchors → what moves them.",
  "kpis": [
    {"id": "kpi.pp-achievement", "name": "Production Plan Achievement Rate", "ko": "생산계획 달성률", "area": "Production & Customer Supply", "perspective": "Production Stability", "formula": "Actual Quantity / Planned Quantity", "anchors": ["Work Order.produced_qty", "Production Plan Item.planned_qty"], "objects": ["Production Plan", "Work Order", "Stock Entry"], "binding": "bound"},
    {"id": "kpi.productivity", "name": "Productivity", "ko": "생산성", "area": "Production & Customer Supply", "perspective": "Production Efficiency per Person", "formula": "Production Quantity / Labor Hours Input", "anchors": ["Work Order.produced_qty", "Job Card Time Log.time_in_mins"], "objects": ["Work Order", "Job Card"], "binding": "capture", "note": "Job Card time logs must be filled on the floor"},
    {"id": "kpi.oee-time", "name": "Equipment Utilization Rate", "ko": "설비 가동률", "area": "Production & Customer Supply", "perspective": "Overall Equipment Efficiency", "formula": "Operating Time / Planned Time", "anchors": ["Job Card Time Log.time_in_mins", "Workstation.working_hours"], "objects": ["Job Card", "Workstation"], "binding": "capture", "note": "workstation shift calendar + job card discipline"},
    {"id": "kpi.otd", "name": "OTD (On-Time Delivery)", "ko": "납기 준수율", "area": "Production & Customer Supply", "perspective": "Customer Responsiveness", "formula": "On-Time Deliveries / Total Deliveries", "anchors": ["Delivery Note.posting_date", "Sales Order Item.delivery_date"], "objects": ["Sales Order", "Delivery Note"], "binding": "bound"},
    {"id": "kpi.process-defect", "name": "Process Defect Rate", "ko": "공정 불량률", "area": "Quality Management", "perspective": "Manufacturing Quality (PPM)", "formula": "Defective Quantity / Production Quantity", "anchors": ["Quality Inspection Reading.status", "Work Order.produced_qty"], "objects": ["Quality Inspection", "Work Order", "Stock Entry"], "binding": "bound"},
    {"id": "kpi.customer-defect", "name": "Customer Defect Rate", "ko": "고객 불량률", "area": "Quality Management", "perspective": "Customer Quality (PPM)", "formula": "Customer Defects / Quantity Delivered", "anchors": ["Quality Inspection.inspection_type", "Delivery Note Item.qty"], "objects": ["Quality Inspection", "Delivery Note", "Issue"], "binding": "capture", "note": "customer-return QI or Issue tagging convention needed"},
    {"id": "kpi.fpy", "name": "First-Pass Yield", "ko": "직행률", "area": "Quality Management", "perspective": "Process Stability", "formula": "Accepted Without Rework / Input Quantity", "anchors": ["Quality Inspection Reading.status", "Stock Entry Detail.qty"], "objects": ["Quality Inspection", "Stock Entry"], "binding": "schema", "note": "rework not distinguishable from normal production — needs a rework flag"},
    {"id": "kpi.inv-turnover", "name": "Inventory Turnover", "ko": "재고 회전율", "area": "Inventory", "perspective": "Inventory Efficiency", "formula": "Shipments / Average Inventory", "anchors": ["Stock Ledger Entry.actual_qty", "Bin.actual_qty"], "objects": ["Stock Ledger Entry", "Bin"], "binding": "bound"},
    {"id": "kpi.optimal-inv", "name": "Optimal Inventory Compliance Rate", "ko": "적정재고 준수율", "area": "Inventory", "perspective": "Overstock and Stockout Management", "formula": "Items Within Standard Range / Total Items", "anchors": ["Bin.actual_qty", "Item Reorder.warehouse_reorder_level"], "objects": ["Bin", "Item"], "binding": "schema", "note": "standard range (min/max) must be defined — reorder levels reusable as floor"},
    {"id": "kpi.fg-days", "name": "Finished-Goods Inventory Days", "ko": "완제품 재고일수", "area": "Inventory", "perspective": "Inventory Health", "formula": "Current Inventory / Average Daily Shipments", "anchors": ["Bin.actual_qty", "Stock Ledger Entry.actual_qty"], "objects": ["Bin", "Stock Ledger Entry"], "binding": "bound"},
    {"id": "kpi.longterm-inv", "name": "Long-Term Inventory Rate", "ko": "장기재고율", "area": "Inventory", "perspective": "Inventory Health", "formula": "Long-Term Inventory / Total Inventory", "anchors": ["Stock Ledger Entry.posting_date", "Bin.actual_qty"], "objects": ["Stock Ledger Entry", "Bin"], "binding": "bound", "note": "Stock Ageing report already buckets by age"},
    {"id": "kpi.samemonth", "name": "Same-Month Receipt and Shipment", "ko": "당월 입출고", "area": "Inventory", "perspective": "Inventory Health", "formula": "Same-Month Receipts and Shipments by Part", "anchors": ["Stock Ledger Entry.posting_date"], "objects": ["Stock Ledger Entry"], "binding": "bound"},
    {"id": "kpi.stockout", "name": "Material Stockout Rate", "ko": "자재 결품률", "area": "Materials & Purchasing", "perspective": "Reduction of Production Loss", "formula": "Stockout Items / Required Items", "anchors": ["Bin.projected_qty", "Item Reorder.warehouse_reorder_level"], "objects": ["Bin", "Material Request", "Item"], "binding": "bound", "note": "same predicate the auto-reorder trigger fires on"},
    {"id": "kpi.purchase-achievement", "name": "Purchase Plan Achievement", "ko": "구매계획 달성률", "area": "Materials & Purchasing", "perspective": "Supply Chain Stability", "formula": "Actual Purchases / Planned Purchases", "anchors": ["Purchase Order Item.qty", "Material Request Item.qty"], "objects": ["Material Request", "Purchase Order"], "binding": "bound"},
    {"id": "kpi.supplier-otd", "name": "Supplier On-Time Delivery Rate", "ko": "협력사 납기 준수율", "area": "Materials & Purchasing", "perspective": "Supply Chain Stability", "formula": "On-Time Receipts / Total Receipts", "anchors": ["Purchase Receipt.posting_date", "Purchase Order Item.schedule_date"], "objects": ["Purchase Order", "Purchase Receipt"], "binding": "bound"},
    {"id": "kpi.outsourced-achievement", "name": "Outsourced Production Plan Achievement", "ko": "외주 생산계획 달성률", "area": "Materials & Purchasing", "perspective": "Outsourced Production Capacity", "formula": "Outsourced Receipts / Outsourced Plan", "anchors": ["Subcontracting Receipt Item.qty", "Subcontracting Order Item.qty"], "objects": ["Subcontracting Order", "Subcontracting Receipt"], "binding": "bound"},
    {"id": "kpi.outsourced-defect", "name": "Outsourced Defect Rate", "ko": "외주 불량률", "area": "Materials & Purchasing", "perspective": "Supplier Quality", "formula": "Outsourced Defects / Outsourced Receipts", "anchors": ["Subcontracting Receipt Item.rejected_qty", "Subcontracting Receipt Item.qty"], "objects": ["Subcontracting Receipt", "Quality Inspection"], "binding": "bound"},
    {"id": "kpi.cost-achievement", "name": "Manufacturing Cost Target Achievement", "ko": "제조원가 목표 달성률", "area": "Cost Management", "perspective": "Profitability", "formula": "Actual Manufacturing Cost / Target Cost", "anchors": ["Stock Entry Detail.valuation_rate", "Work Order.planned_operating_cost"], "objects": ["Work Order", "Stock Entry", "BOM"], "binding": "schema", "note": "target cost concept missing — BOM has cost, no target field"},
    {"id": "kpi.logistics-ratio", "name": "Logistics Cost Ratio", "ko": "물류비 비율", "area": "Cost Management", "perspective": "Profitability", "formula": "Logistics Cost / Sales Revenue", "anchors": ["Landed Cost Voucher.total_taxes_and_charges", "Sales Invoice.base_net_total"], "objects": ["Landed Cost Voucher", "Sales Invoice"], "binding": "schema", "note": "outbound logistics needs expense-account/cost-center tagging convention"},
    {"id": "kpi.labor-ratio", "name": "Labor Cost Ratio", "ko": "인건비 비율", "area": "Cost Management", "perspective": "Workforce Efficiency", "formula": "Labor Cost / Sales Revenue", "anchors": ["GL Entry.debit", "Sales Invoice.base_net_total"], "objects": ["GL Entry", "Sales Invoice"], "binding": "capture", "note": "labor accounts must be consistently posted (payroll app or JE discipline)"},
    {"id": "kpi.sales-per-emp", "name": "Sales per Employee", "ko": "인당 매출", "area": "Management & Overall", "perspective": "Organizational Productivity", "formula": "Sales Revenue / Average Headcount", "anchors": ["Sales Invoice.base_net_total", "Employee.status"], "objects": ["Sales Invoice", "Employee"], "binding": "bound"},
    {"id": "kpi.sales-achievement", "name": "Sales Plan Achievement Rate", "ko": "매출계획 달성률", "area": "Management & Overall", "perspective": "Business Plan Achievement", "formula": "Actual Sales / Sales Plan", "anchors": ["Sales Invoice.base_net_total", "Target Detail.target_amount"], "objects": ["Sales Invoice", "Sales Person"], "binding": "bound"},
    {"id": "kpi.op-margin", "name": "Operating Profit Margin", "ko": "영업이익률", "area": "Management & Overall", "perspective": "Profitability", "formula": "Operating Profit / Sales Revenue", "anchors": ["GL Entry.credit", "GL Entry.debit"], "objects": ["GL Entry", "Sales Invoice", "Purchase Invoice"], "binding": "bound", "note": "P&L via Financial Report Template engine"},
    {"id": "kpi.exceptions", "name": "Exceptions / Delays", "ko": "예외·지연", "area": "Management & Overall", "perspective": "Management Risk", "formula": "Production, Quality, and Delivery Exceptions", "anchors": ["*rules.block", "*rules.warn"], "objects": [], "binding": "bound", "note": "the definition of exception IS the extracted rules — counts come from rule firings (OBSERVED)"}
  ]
}
